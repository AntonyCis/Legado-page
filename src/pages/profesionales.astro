---
import { Image } from "astro:assets";
import { images } from "../assets/images";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Profesionales"
  description="Conoce al equipo de socios y profesionales directivos de LEGADO CONSULTING LAW en Ecuador."
>
  <!-- HERO PROFESIONALES -->
  <section class="relative bg-surface-dark text-on-surface-dark overflow-hidden border-b border-outline-dark">
    <div class="absolute inset-0">
      <Image
        src={images.hero_profesionales}
        alt="Panorámica urbana en Ecuador — Socios de LEGADO CONSULTING LAW"
        class="w-full h-full object-cover opacity-30"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-deep-black via-deep-black/90 to-deep-black/50"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-gutter-lg md:px-12 py-section-md md:py-section-lg flex flex-col gap-gutter-lg">
      <div class="flex items-center gap-gutter-md">
        <span class="w-10 h-px bg-champagne-gold"></span>
        <span class="font-label text-label-md uppercase text-champagne-gold">Equipo de Socios</span>
      </div>
      <h1 class="font-display text-display-xl-mobile md:text-display-xl text-pure-white max-w-4xl text-balance">
        El criterio detrás de <span class="text-champagne-gold italic">cada decisión</span>.
      </h1>
      <p class="font-body text-body-lg text-light-gray max-w-2xl text-pretty">
        Nuestro equipo está conformado por tres profesionales que participan directamente en la estrategia y ejecución de cada caso, garantizando rigor técnico y cercanía real.
      </p>
    </div>
  </section>

  <!-- EQUIPO (TRES PERFILES EQUIVALENTES EN COMPOSICIÓN EDITORIAL) -->
  <section class="bg-surface text-on-surface py-section-md md:py-section-lg border-b border-outline">
    <div class="max-w-7xl mx-auto px-gutter-lg md:px-12 flex flex-col gap-section-md">

      <!-- Integrante 01 -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-xl lg:gap-16 items-center border-b border-outline pb-section-sm">
        <div class="lg:col-span-5">
          <div class="aspect-[3/4] w-full overflow-hidden bg-deep-black border border-outline">
            <Image
              src={images.partner_1}
              alt="Retrato profesional del primer integrante"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <div class="lg:col-span-7 flex flex-col gap-gutter-md">
          <div class="flex items-center gap-gutter-md">
            <span class="w-8 h-px bg-champagne-gold"></span>
            <span class="font-label text-label-md uppercase text-champagne-gold-dark">[Cargo dentro de la firma]</span>
          </div>
          <h2 class="font-headline text-headline-lg-mobile md:text-headline-lg text-on-surface">
            [Nombre Completo 1]
          </h2>
          <p class="font-title text-title-md text-neutral-text-muted">
            [Especialidad profesional]
          </p>
          <p class="font-body text-body-md text-neutral-text-muted max-w-prose text-pretty">
            [Biografía breve editable: describe su trayectoria profesional, áreas de enfoque y rol dentro de LEGADO CONSULTING LAW sin inventar datos.]
          </p>
          <div class="border-t border-outline pt-gutter-md flex flex-col gap-gutter-xs">
            <span class="font-label text-label-md uppercase text-champagne-gold-dark">Formación académica</span>
            <p class="font-body text-body-sm text-on-surface">[Título universitario / Especialización — Institución académica]</p>
          </div>
          <div class="pt-gutter-xs">
            <span class="inline-flex items-center gap-gutter-xs border-b border-on-surface pb-1 font-label text-label-lg uppercase text-on-surface hover:border-champagne-gold hover:text-champagne-gold-dark transition-colors duration-state-change cursor-pointer">
              <span>Perfil de LinkedIn</span>
              <Icon name="north-east" class="text-body-md" />
            </span>
          </div>
        </div>
      </article>

      <!-- Integrante 02 -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-xl lg:gap-16 items-center border-b border-outline pb-section-sm">
        <div class="lg:col-span-5">
          <div class="aspect-[3/4] w-full overflow-hidden bg-deep-black border border-outline">
            <Image
              src={images.partner_2}
              alt="Retrato profesional de la segunda integrante"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <div class="lg:col-span-7 flex flex-col gap-gutter-md">
          <div class="flex items-center gap-gutter-md">
            <span class="w-8 h-px bg-champagne-gold"></span>
            <span class="font-label text-label-md uppercase text-champagne-gold-dark">[Cargo dentro de la firma]</span>
          </div>
          <h2 class="font-headline text-headline-lg-mobile md:text-headline-lg text-on-surface">
            [Nombre Completo 2]
          </h2>
          <p class="font-title text-title-md text-neutral-text-muted">
            [Especialidad profesional]
          </p>
          <p class="font-body text-body-md text-neutral-text-muted max-w-prose text-pretty">
            [Biografía breve editable: describe su trayectoria profesional, áreas de enfoque y rol dentro de LEGADO CONSULTING LAW sin inventar datos.]
          </p>
          <div class="border-t border-outline pt-gutter-md flex flex-col gap-gutter-xs">
            <span class="font-label text-label-md uppercase text-champagne-gold-dark">Formación académica</span>
            <p class="font-body text-body-sm text-on-surface">[Título universitario / Especialización — Institución académica]</p>
          </div>
          <div class="pt-gutter-xs">
            <span class="inline-flex items-center gap-gutter-xs border-b border-on-surface pb-1 font-label text-label-lg uppercase text-on-surface hover:border-champagne-gold hover:text-champagne-gold-dark transition-colors duration-state-change cursor-pointer">
              <span>Perfil de LinkedIn</span>
              <Icon name="north-east" class="text-body-md" />
            </span>
          </div>
        </div>
      </article>

      <!-- Integrante 03 -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-xl lg:gap-16 items-center">
        <div class="lg:col-span-5">
          <div class="aspect-[3/4] w-full overflow-hidden bg-deep-black border border-outline">
            <Image
              src={images.partner_3}
              alt="Retrato profesional del tercer integrante"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <div class="lg:col-span-7 flex flex-col gap-gutter-md">
          <div class="flex items-center gap-gutter-md">
            <span class="w-8 h-px bg-champagne-gold"></span>
            <span class="font-label text-label-md uppercase text-champagne-gold-dark">[Cargo dentro de la firma]</span>
          </div>
          <h2 class="font-headline text-headline-lg-mobile md:text-headline-lg text-on-surface">
            [Nombre Completo 3]
          </h2>
          <p class="font-title text-title-md text-neutral-text-muted">
            [Especialidad profesional]
          </p>
          <p class="font-body text-body-md text-neutral-text-muted max-w-prose text-pretty">
            [Biografía breve editable: describe su trayectoria profesional, áreas de enfoque y rol dentro de LEGADO CONSULTING LAW sin inventar datos.]
          </p>
          <div class="border-t border-outline pt-gutter-md flex flex-col gap-gutter-xs">
            <span class="font-label text-label-md uppercase text-champagne-gold-dark">Formación académica</span>
            <p class="font-body text-body-sm text-on-surface">[Título universitario / Especialización — Institución académica]</p>
          </div>
          <div class="pt-gutter-xs">
            <span class="inline-flex items-center gap-gutter-xs border-b border-on-surface pb-1 font-label text-label-lg uppercase text-on-surface hover:border-champagne-gold hover:text-champagne-gold-dark transition-colors duration-state-change cursor-pointer">
              <span>Perfil de LinkedIn</span>
              <Icon name="north-east" class="text-body-md" />
            </span>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-surface-warm text-on-surface-warm py-section-md md:py-section-lg">
    <div class="max-w-4xl mx-auto px-gutter-lg md:px-12 text-center flex flex-col items-center gap-gutter-lg">
      <span class="w-12 h-px bg-champagne-gold"></span>
      <h2 class="font-display text-display-lg-mobile md:text-display-lg text-on-surface text-balance">
        Conoce cómo podemos acompañarte.
      </h2>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center bg-primary text-on-primary border border-primary px-gutter-xl py-gutter-md font-label text-label-lg uppercase transition-colors duration-state-change ease-state-change hover:bg-secondary hover:border-champagne-gold"
      >
        Contáctanos
      </a>
    </div>
  </section>
</Layout>
